{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "hiking",
  "main": "src/index.ts",
  "compatibility_date": "2026-11-17",
  "workers_dev": false,
  "routes": [{ "pattern": "hiking.bitcru.sh", "custom_domain": true }],
  "observability": {
    "enabled": true,
    // Request logs keep the path only: the sign-in callback's query holds a
    // one-time OAuth code and state, which must never be stored in a log.
    "redact_query_string": true,
  },
  // Files under public/ are served at the same path before the Worker runs
  // (public/assets/app.css is /assets/app.css); public/_headers sets their
  // caching and public/.assetsignore keeps the rule files out.
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "GUILD_HIKE",
        "class_name": "GuildHike",
      },
      // Draws map pictures (src/maps/map-painter.ts).
      {
        "name": "MAP_PAINTER",
        "class_name": "MapPainter",
      },
    ],
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["GuildHike"],
    },
    {
      "tag": "v2",
      "new_sqlite_classes": ["MapPainter"],
    },
  ],
  // OpenStreetMap vector tiles (PMTiles archives and their manifest), written
  // by the Map data workflow. Deploy creates the bucket if it is missing.
  "r2_buckets": [
    {
      "binding": "MAPS",
      "bucket_name": "hikebot-maps",
    },
  ],
  "vars": {
    // Tests and local runs override this to point at a fake Discord API.
    "DISCORD_API_BASE": "https://discord.com/api/v10",
    // The Worker's own origin, for absolute links; tests set an example one.
    "PUBLIC_URL": "https://hiking.bitcru.sh",
    // Where web sign-in sends the browser to authorize; tests point it at the
    // fake Discord API.
    "DISCORD_OAUTH_AUTHORIZE_URL": "https://discord.com/oauth2/authorize",
  },
  // The deploy workflow sets them from GitHub Actions secrets; locally they come
  // from .dev.vars.
  "secrets": {
    "required": [
      "DISCORD_PUBLIC_KEY",
      "DISCORD_APPLICATION_ID",
      "DISCORD_BOT_TOKEN",
      "DISCORD_CLIENT_SECRET",
      "SIGNING_SECRET",
    ],
  },
}
