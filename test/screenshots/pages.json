  "excluded": [
    {
      "route": "/assets/*",
      "reason": "Static files such as the stylesheet, not pages; every page's screenshot shows them in use."
    },
    {
      "route": "/assets/v/*",
      "reason": "The same static files under the deployed version, cacheable for a year; every page's screenshot shows them in use."
    },
    {
      "route": "/healthz",
      "reason": "The plain-text health line for deploy checks and monitoring, not a page."
    },
    {
      "route": "/calendar/*",
      "reason": "The iCal feed of a server's hikes (text/calendar) for calendar apps, not a page a browser shows."
    },
    {
      "route": "/login",
      "reason": "Starts sign-in: sets the state cookie and redirects to Discord's authorize page, so it has no page of its own; the sign-in pages are screenshotted from the callback."
    },
    {
      "route": "/maps/sample.png",
      "reason": "The sample map picture (image/png) the deploy's smoke check fetches, not a page; its views are reviewed in public/assets/maps/samples/ (npm run maps:samples) and shown on /styleguide/map."
    },
    {
      "route": "/tiles/*",
      "reason": "The interactive map's vector tiles (application/vnd.mapbox-vector-tile), not a page; the map pages' screenshots show them drawn."
    },
    {
      "route": "/maps/style.json",
      "reason": "The interactive map's style (JSON), not a page; the map pages' screenshots show it drawn."
    }
  ]
