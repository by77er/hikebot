{
  "name": "hikebot",
  "version": "0.0.0",
  "private": true,
  "description": "Discord bot that runs a hiking group's location and date votes, on Cloudflare Workers.",
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "wrangler dev",
    "test": "vitest run",
    "test:e2e": "vitest run --project e2e",
    "lint": "eslint .",
    "typecheck": "wrangler types --check && tsc --noEmit && tsc --noEmit -p test && tsc --noEmit -p test/e2e && tsc --noEmit -p test/e2e/probe && tsc --noEmit -p scripts && tsc --noEmit -p test/screenshots",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "deploy": "wrangler deploy",
    "register": "tsx scripts/register-commands.ts",
    "cf-typegen": "wrangler types",
    "screenshots": "tsx test/screenshots/take.ts",
    "screenshots:check": "tsx test/screenshots/take.ts --check",
    "screenshots:table": "tsx test/screenshots/table.ts",
    "description:check": "tsx test/screenshots/description.ts",
    "maps:samples": "tsx scripts/draw-map-samples.ts"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "^1.8.4",
    "@eslint/js": "^10.0.1",
    "@fontsource-variable/public-sans": "5.3.0",
    "@maplibre/maplibre-gl-style-spec": "26.8.0",
    "@sparticuz/chromium": "^153.0.0",
    "@types/node": "^24.19.2",
    "@typescript/lib-dom": "file:types/lib-dom",
    "discord-api-types": "^0.38.59",
    "eslint": "^10.15.0",
    "globals": "^17.14.0",
    "ical.js": "^2.2.1",
    "maplibre-gl": "6.19.0",
    "prettier": "^3.10.1",
    "puppeteer-core": "^25.18.1",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.73.0",
    "vitest": "^5.1.1",
    "wrangler": "^4.164.0"
  },
  "dependencies": {
    "@mapbox/vector-tile": "^3.0.0",
    "@resvg/resvg-wasm": "^2.6.2",
    "pbf": "^5.2.0",
    "pmtiles": "^4.5.0",
    "preact": "^11.2.0",
    "preact-render-to-string": "^6.8.3"
  }
}
